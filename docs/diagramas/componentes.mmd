flowchart TB
  subgraph navegador[Navegador]
    forms[Formularios React]
    session[Estado de sesión y CSRF]
    client[Cliente API]
    forms --> client
    session --> client
  end
  subgraph node[Proceso Node]
    app[Express app]
    auth[Router auth]
    users[Router usuarios / roles]
    trainings[Router capacitaciones]
    security[Seguridad y validación]
    userService[Servicio usuarios]
    trainingService[Servicio capacitaciones]
    db[Persistencia y migraciones]
    app --> auth
    app --> users
    app --> trainings
    auth --> security
    users --> security
    trainings --> security
    users --> userService
    trainings --> trainingService
    auth --> db
    security --> db
    userService --> db
    trainingService --> db
  end
  client -->|HTTP misma procedencia| app
  db --> archivo[(Archivo SQLite)]
  tests[Node Test Runner + Supertest]
  tests -->|createApp con base aislada| app
